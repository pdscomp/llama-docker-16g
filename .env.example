# Copy to .env. LOCAL_UID and LOCAL_GID are always derived from the caller.
HF_CACHE_DIR=../hf-cache
RUNTIME_DIR=.state/runtime
PROMPT_CACHE_DIR=.state/prompt-cache
# Optional existing model directory, mounted read-only at /models.
LOCAL_MODELS_DIR=.state/models
HOST_PORT=8080
IMAGE_TAG=vulkan-latest

# Default 16 GiB Qwen 3.8 profile.
HF_REPO=unsloth/Qwen3.8-27B-GGUF
HF_FILE=Qwen3.8-27B-UD-Q3_K_XL.gguf
MODEL_ALIAS=Qwen3.8-27B
CTX_SIZE=73728
BATCH_SIZE=1024
UBATCH_SIZE=512
THREADS=8
THREADS_BATCH=8
CACHE_K=q4_1
CACHE_V=q4_1
PARALLEL=1
KV_UNIFIED=0

# Empty = discover every hardware Vulkan device. Set a comma-separated llama.cpp
# list such as Vulkan0,Vulkan2 to override automatic device selection.
VULKAN_DEVICES=

BUILD_JOBS=8
BUILDX_BUILDER=llama-vulkan-builder
HF_XET_HIGH_PERFORMANCE=1

